{
  "manifest_version": 3,
  "name": "Job Application Tracker",
  "version": "2.0.0",
  "description": "Save jobs from LinkedIn, Indeed, Wellfound, Internshala and Naukri and track your applications.",

  "action": {
    "default_popup": "popup.html",
    "default_title": "Job Tracker"
  },

  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],

  "host_permissions": [
    "http://localhost:5000/*"
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http://localhost:5000"
  }
}
