{
  "manifest_version": 3,
  "name": "Job Application Tracker",
  "version": "1.0",

  "action": {
    "default_popup": "popup.html"
  },

  "permissions": [
    "scripting",
    "activeTab",
    "storage"
  ],

  "host_permissions": [
    "http://localhost:5000/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "utils/websiteDetector.js",
        "content.js"
      ]
    }
  ]
}