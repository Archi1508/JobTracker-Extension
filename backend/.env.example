# Port the API listens on. The extension expects http://localhost:5000.
PORT=5000

# PostgreSQL connection string (Supabase: Project Settings -> Database -> Connection string).
# If your network has no IPv6, use Supabase's "Session pooler" connection string instead.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Secret used to sign login tokens. At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# How long a login lasts (jsonwebtoken format, e.g. 7d, 12h).
JWT_EXPIRES_IN=7d

# Optional: comma separated extension origins allowed by CORS,
# e.g. chrome-extension://abcdefghijklmnopabcdefghijklmnop
# Leave empty to allow any chrome-extension:// origin (local development).
CORS_ORIGINS=
